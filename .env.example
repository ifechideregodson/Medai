DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/medai

# Primary private object storage
S3_REGION=us-east-1
S3_BUCKET=private-medai-assets
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256

# Secondary/failover private object storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clinical review
MEDAI_ALLOW_IMAGE_EMBED=true

# Clinical model gateway
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_TIMEOUT_MS=60000

# OpenAI provider (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_VERSION=current
